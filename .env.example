# ── Base de datos ───────────────────────────────────────────────────────────
POSTGRES_USER=fina
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=fina
POSTGRES_PORT=5432
DATABASE_URL=postgres://fina:cambia-esta-clave@db:5432/fina
# TLS hacia la base: disable (Postgres en la red interna de Docker),
# require (valida el certificado) o no-verify (proveedores gestionados).
DATABASE_SSL=disable
# Conexiones simultaneas del pool. Bajalo a 3 si despliegas en serverless.
DB_POOL_MAX=10

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
# Genera uno con:  openssl rand -hex 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres
JWT_EXPIRES_IN=12h
# Origen del frontend. Usa * solo en desarrollo.
CORS_ORIGIN=http://localhost:8080

# ── Datos de la organizacion (se usan al ejecutar el seed) ──────────────────
ORG_NOMBRE=Mi Negocio, C.A.
ORG_RIF=J-000000000
ORG_MONEDA_BASE=USD
ADMIN_EMAIL=admin@minegocio.com
ADMIN_PASSWORD=Admin.12345
ADMIN_NOMBRE=Administrador
# Dias de historia que genera el seed de ejemplo.
SEED_DIAS=45

# ── Reglas fiscales (Venezuela) ─────────────────────────────────────────────
IVA_TASA=16
IGTF_TASA=3

# ── Tasa de cambio ──────────────────────────────────────────────────────────
# manual  -> la tasa se carga a mano desde Configuracion (100% offline)
# http    -> se consulta TASA_FUENTE_URL una vez al dia
TASA_FUENTE=manual
TASA_FUENTE_URL=
TASA_INICIAL=36.50

# ── Asistente ───────────────────────────────────────────────────────────────
# local    -> motor de consultas deterministico, sin salida a internet
# anthropic-> usa la API de Claude para respuestas en lenguaje natural
ASISTENTE_MODO=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Frontend ────────────────────────────────────────────────────────────────
WEB_PORT=8080
VITE_API_URL=/api
